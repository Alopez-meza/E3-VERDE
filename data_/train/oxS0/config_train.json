{
  "mode": "train",
  "model": {
    "em_dim": 32,
    "irreps_in": "32x0e",
    "irreps_out": "1x0e",
    "irreps_node_attr": "1x0e",
    "layers": 5,
    "mul": 48,
    "lmax": 2,
    "number_of_basis": 16,
    "radial_layers": 2,
    "radial_neurons": 64,
    "max_radius": 5.0,
    "num_neighbors": -1,
    "reduce_output": true,
    "dropout": 0.2,
    "use_layer_norm": false,
    "use_residual": true,
    "use_self_interaction": true,
    "use_rich_features": true,
    "readout_type": "attention",
    "output_mlp_layers": 1,
    "output_mlp_hidden": 32,
    "use_multiscale_readout": false
  },
  "train": {
    "num_epochs": 300,
    "batch_size": 8,
    "learning_rate": 0.00549627611957491,
    "weight_decay": 2.212536241248627e-06,
    "patience": 15,
    "scheduler_type": "cosine_warmup",
    "warmup_epochs": -1,
    "clip_grad_norm": 5.0,
    "label_smoothing": 0.0,
    "loss_function": "l1",
    "min_lr": 1e-07,
    "use_amp": true,
    "gradient_accumulation_steps": 1,
    "use_ema": false,
    "ema_decay": 0.999,
    "num_workers": 0
  },
  "data": {
    "dataset_path": "verde+PCs.json",
    "target_key": "oxidation_potential_S0 (eV)",
    "structure_field": "xyz_S0",
    "test_size": 0.1,
    "val_size": 0.1,
    "normalize_targets": true,
    "normalize_features": true,
    "target_normalization": "auto",
    "seed": 42
  },
  "pretrained_model_file": "data_/predict/oxS0/verde_best.pt"
}
