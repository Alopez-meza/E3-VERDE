{
  "mode": "predict",
  "pretrained_model_file": "data_/predict/redT1/verde_best.pt",
  "molecules_path": "data_/predict/xyz",
  "molecules_format": "xyz",
  "model": {
    "em_dim": 128,
    "irreps_in": "128x0e",
    "irreps_out": "1x0e",
    "irreps_node_attr": "1x0e",
    "layers": 5,
    "mul": 32,
    "lmax": 2,
    "number_of_basis": 16,
    "radial_layers": 2,
    "radial_neurons": 64,
    "max_radius": 5.5,
    "num_neighbors": -1,
    "reduce_output": true,
    "dropout": 0.2,
    "use_layer_norm": false,
    "use_residual": true,
    "use_self_interaction": true,
    "use_rich_features": true,
    "readout_type": "mean",
    "output_mlp_layers": 3,
    "output_mlp_hidden": 32,
    "use_multiscale_readout": true
  },
  "train": {
    "num_epochs": 300,
    "batch_size": 8,
    "learning_rate": 0.006794825405094241,
    "weight_decay": 5.036631551559894e-06,
    "patience": 15,
    "scheduler_type": "cosine_warmup",
    "warmup_epochs": -1,
    "clip_grad_norm": 10.0,
    "label_smoothing": 0.0,
    "loss_function": "l1",
    "min_lr": 1e-07,
    "use_amp": true,
    "gradient_accumulation_steps": 1,
    "use_ema": true,
    "ema_decay": 0.999,
    "num_workers": 0
  },
  "data": {
    "dataset_path": "verde+PCs.json",
    "target_key": "reduction_potential_T1 (eV)",
    "structure_field": "xyz_S0",
    "test_size": 0.1,
    "val_size": 0.1,
    "normalize_targets": true,
    "target_normalization": "auto",
    "seed": 42
  }
}
